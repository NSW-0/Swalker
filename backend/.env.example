# Copy to backend/.env and adjust. Every key is optional; these are the defaults.
SWALKER_CHECKPOINT_PATH=models/stage2_iter70000.pth
SWALKER_DEVICE=auto
SWALKER_PREPROCESS_MODE=casia_clip
SWALKER_TARGET_FPS=25
SWALKER_MAX_FRAMES=120
SWALKER_MIN_FRAMES=15
# Measured on raw CASIA-B videos (casia_videos). Check it with
# scripts/calibrate_threshold.py on real recordings, then set THRESHOLD_CALIBRATED=true.
SWALKER_MATCH_THRESHOLD=8.0
SWALKER_THRESHOLD_CALIBRATED=false
SWALKER_MAX_UPLOAD_MB=100
